# Copy to .env for local development. On Botkeep, set these as Environment secrets.
DATABASE_URL=sqlite:///scribddown.db
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@scribddown.local
# bcrypt hash of the admin password (generate: python -c "import bcrypt; print(bcrypt.hashpw(b'YOURPASS', bcrypt.gensalt()).decode())")
ADMIN_PASSWORD_HASH=
APP_URL=http://localhost:8000
PORT=8000
